# ------------------------------
# Gradio 应用
# ------------------------------

APP_HOST=127.0.0.1
APP_PORT=7860
APP_TIMEZONE=Asia/Shanghai

# 默认隐藏只供开发和验收使用的“运行证据”页面。
HEALTHOS_SHOW_DEVELOPER_UI=false

# 本地优先网页：业务状态默认保存到 SQLite。
# 回滚到旧文件存储时设置为 json；迁移不会删除旧文件。
STORAGE_BACKEND=sqlite
SQLITE_DATABASE_PATH=data/healthos.db

# ------------------------------
# 食物 RAG
# ------------------------------

# lexical：确定性词法检索
# hybrid：词法 + Dense + RRF
RAG_MODE=lexical

# 可选：覆盖食物数据文件
FOOD_DATA_PATH=

# Dense 索引目录
FOOD_INDEX_DIR=data/index

# ------------------------------
# 餐食图片识别（可选增强，默认关闭）
# ------------------------------

# disabled：不识别，上传图片后手动填写食物名称和份量。
#
# vlm：用多模态大模型识别，能认中餐（米饭、番茄炒蛋、宫保鸡丁）。
#   ⚠️ 图片会发送给你配置的模型服务商，本机不保存原图但图片离开了本机。
#   需要该模型支持图片输入，且每张图有 token 成本。
#
# onnx：本地离线 YOLOv8n，不联网、免费、约 35ms。
#   ⚠️ 只认 COCO 的 10 个食物类（苹果、香蕉、橙、西兰花、胡萝卜、
#   披萨、三明治、热狗、甜甜圈、蛋糕）。它是闭集分类器，没有"不认识"
#   这个选项，所以会把番茄说成苹果、把米饭说成蛋糕。中餐不要用这个模式。
#
# 两种模式下识别都只负责预填名称，份量、候选确认、营养计算和保存
# 一步都不跳过；识别不可用或识别不到时自动回退手动填写。
MEAL_DETECTION_MODE=disabled

# ONNX 权重路径，相对路径按项目根目录解析。
# 先运行 python scripts/prepare_food_detection_model.py 下载并导出。
# 权重是 Ultralytics AGPL-3.0 授权，不随本仓库分发。
MEAL_DETECTION_MODEL_PATH=runtime/models/yolov8n.onnx

# 置信度下限，取值范围 0.05—0.95。调高会少预填，调低会多误报。
MEAL_DETECTION_MIN_CONFIDENCE=0.35

# 仅 vlm 模式使用。留空则分别回退到 AGENT_MODEL / AGENT_API_KEY /
# AGENT_BASE_URL。文本模型不支持图片输入时，在这里单独指向一个支持
# 图片的 OpenAI-compatible 服务，不影响对话用的模型。
MEAL_DETECTION_VLM_MODEL=
MEAL_DETECTION_VLM_API_KEY=
MEAL_DETECTION_VLM_BASE_URL=
MEAL_DETECTION_VLM_TIMEOUT=20

# ------------------------------
# Agent 模型 Provider
# ------------------------------

# disabled：
# 不调用模型，页面仍可启动，饮食手动流程和时间线仍可使用。
#
# openai_compatible：
# 使用支持 Chat Completions 和 tools 的 Provider。
AGENT_PROVIDER_MODE=disabled

# 不要把真实 API Key 提交到 Git
AGENT_API_KEY=

# OpenAI 官方地址：
# https://api.openai.com/v1
#
# 其他 Provider 请填写其 OpenAI-compatible Base URL。
AGENT_BASE_URL=https://api.openai.com/v1

# 填写你的 Provider 实际支持并且支持 tools 的模型名称
AGENT_MODEL=

# 15 秒是体验目标，60 秒是单次模型请求硬上限。
# 为避免 SDK 重试把总等待放大到数分钟，自动重试固定关闭；失败后由用户决定重试。
AGENT_TARGET_RESPONSE_SECONDS=15
AGENT_REQUEST_TIMEOUT=60
AGENT_MAX_RETRIES=0
AGENT_MAX_TOKENS=1024
# auto 使用 Provider 默认值；DeepSeek 简单 Tool 调用建议 disabled。
AGENT_THINKING_MODE=auto

# Agent 编排实现：
# legacy：原有有限轮次 Python Loop
# langgraph：StateGraph + interrupt + checkpoint
AGENT_ORCHESTRATOR=langgraph

# ------------------------------
# LangSmith 可观测性（可选）
# ------------------------------
# 在 https://smith.langchain.com 的 Settings > API Keys 创建密钥。
# 健康数据默认不上传，只记录节点结构、耗时、错误与调用关系。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=health-assistant-agent-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# API Key 关联多个 Workspace 时填写。
LANGSMITH_WORKSPACE_ID=

# ------------------------------
# 确认令牌
# ------------------------------

# 建议本地固定一个随机长字符串。
# 如果不设置，每次 Python 进程重启都会生成临时密钥，
# 重启前签发的确认草稿会失效。
HEALTH_CONFIRMATION_SECRET=

# ------------------------------
# 飞书提醒自动化（可选）
# ------------------------------

# 开启后，用户仍需在对话中确认提醒草稿；只有已确认且到期的任务才会发送。
FEISHU_REMINDER_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=
FEISHU_DESTINATION_LABEL=飞书群「健康提醒」
FEISHU_REQUEST_TIMEOUT=8
REMINDER_POLL_SECONDS=30
