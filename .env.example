# 应用可在没有 API Key 的情况下启动。
APP_HOST=127.0.0.1
APP_PORT=7860
APP_TIMEZONE=Asia/Shanghai

# lexical：只使用原有确定性词法检索。
# hybrid：词法检索 + Dense 向量检索 + RRF。
RAG_MODE=lexical

# 可选：覆盖食物数据文件。
# 不设置时优先使用 data/full/foods_normalized.json，
# 文件不存在时回退到 data/samples/foods_sample.json。
FOOD_DATA_PATH=

# 向量索引目录。
FOOD_INDEX_DIR=data/index

# 可选：用于签发“确认保存”令牌。
# 不设置时每次进程启动会生成临时密钥。
HEALTH_CONFIRMATION_SECRET=