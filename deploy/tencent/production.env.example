# 腾讯云香港实例不要求 ICP 备案；域名必须先解析到实例公网 IP。
DOMAIN=health.example.com

# Caddy Basic Auth。BASIC_AUTH_HASH 必须是哈希，不能填写明文密码。
BASIC_AUTH_USER=healthos
BASIC_AUTH_HASH='$2a$14$replace_with_caddy_hash_password_output'

APP_TIMEZONE=Asia/Shanghai
RAG_MODE=lexical

# 图片识别默认关闭。要开启：先在宿主机运行
#   python scripts/prepare_food_detection_model.py
# 再把 runtime/models/ 复制到 deploy/tencent/runtime-data/models/，
# 然后把下面改成 onnx 并重启。权重是 Ultralytics AGPL-3.0，不随镜像分发。
MEAL_DETECTION_MODE=disabled
MEAL_DETECTION_MIN_CONFIDENCE=0.35

AGENT_PROVIDER_MODE=openai_compatible
AGENT_API_KEY=
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-v4-flash
AGENT_TARGET_RESPONSE_SECONDS=15
AGENT_REQUEST_TIMEOUT=60
AGENT_MAX_TOKENS=1024
AGENT_THINKING_MODE=disabled
AGENT_ORCHESTRATOR=langgraph

# 使用 openssl rand -hex 32 生成。更换它会让重启前生成的确认草稿失效。
HEALTH_CONFIRMATION_SECRET=replace_with_openssl_rand_hex_32

FEISHU_REMINDER_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=
FEISHU_DESTINATION_LABEL=飞书群「健康提醒」
FEISHU_REQUEST_TIMEOUT=8
REMINDER_POLL_SECONDS=30

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=health-assistant-agent-tencent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_WORKSPACE_ID=
